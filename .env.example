# Slack — create an app at api.slack.com/apps in the target workspace.
# Enable Socket Mode. Bot token scopes: channels:history, chat:write.
# App-level token scope: connections:write.
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# Channel ID the bot watches (right-click channel name → View channel details → copy ID).
SLACK_WATCH_CHANNEL_ID=C0XXXXXXX
