# Slack — create an app at api.slack.com/apps in the target workspace.
# Enable Socket Mode. Bot token scopes: channels:history, chat:write.
# App-level token scope: connections:write.
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# Channel ID the bot watches (right-click channel name → View channel details → copy ID).
# Default: #ext-everhelp-dicey-alerts
SLACK_WATCH_CHANNEL_ID=C0ACMU6DHFA

# Optional: restrict processing to the SOFTSWISS Alerts bot by exact bot_id.
# Falls back to a name-based heuristic (matches /softswiss/i in bot_profile.name
# or username) when unset. Set this once you've captured a real bot_id from
# a delivered message to make the filter tamper-proof.
SOFTSWISS_BOT_ID=

# Slack user-group ID (S-prefixed) to @mention on actionable alerts —
# recall+active, URGENT+active, RTP change+active, enabled-back with prior
# recalls, maintenance for a tracked provider. Default below = @mops-dicey.
# Empty = no @mention, alert body still posts.
SLACK_ALERT_USERGROUP_ID=S09Q4GUKX4Y

# Optional channel ID for bot-error notifications: handler crashes, reply
# post failures, canary failures. Separate from the watch channel to keep
# user-facing noise low. Empty = log only, no Slack post.
SLACK_ERRORS_CHANNEL_ID=

# Logging level for pino: trace | debug | info | warn | error | fatal.
LOG_LEVEL=info
